node_modules/
out/
.DS_Store
# Secrets: never commit real keys. Only .env.example is committed.
.env
.env.*
!.env.example
# Navoiy TTS local runtime: Python venv, CosyVoice checkout, model weights (~8 GB)
.navoiy/
# Reference voice recordings are personal data — not committed by default.
tts/voices/*.wav
# Generated voiceovers are outputs (like out/). Only the "namuna" sample is committed.
public/voiceover/*
!public/voiceover/.gitkeep
!public/voiceover/namuna.*
