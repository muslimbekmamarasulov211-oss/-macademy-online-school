# ---------------------------------------------------------------------------
# M.ACADEMY ONLINE SCHOOL — environment variables
#
# Copy this file to `.env.local` and fill in real values for your machine.
#   cp .env.example .env.local
#
# RULES
# - Never commit `.env.local` or any file containing real secrets.
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   NEVER put secrets (API keys, tokens, passwords) in a NEXT_PUBLIC_ variable.
# - Add every new variable here (with a safe example value) and document it.
# ---------------------------------------------------------------------------

# Public, canonical URL of the site (no trailing slash).
# Used for metadata (canonical links, Open Graph). Safe to expose.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
