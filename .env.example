# ---------------------------------------------------------------------------
# M.ACADEMY ONLINE SCHOOL — environment variables
#
# Copy this file to `.env.local` and fill in real values for your machine.
#   cp .env.example .env.local
#
# RULES
# - Never commit `.env.local` or any file containing real secrets.
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   NEVER put secrets (API keys, tokens, passwords) in a NEXT_PUBLIC_ variable.
# - Add every new variable here (with a safe example value) and document it.
# ---------------------------------------------------------------------------

# Public, canonical URL of the site (no trailing slash).
# Used for metadata (canonical links, Open Graph). Safe to expose.
# When unset: on Vercel the deployment's own URL is used automatically
# (branch URL for previews, production domain for production);
# elsewhere it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Aisha AI API key for Uzbek text-to-speech (/tools/ovoz → /api/tts).
# Get one at https://voicelab.uz/app — sent as the X-Api-Key header.
# Read only by src/config/env.server.ts. When unset, the tool reports
# "not configured" instead of calling the API.
AISHA_API_KEY=your-aisha-api-key
